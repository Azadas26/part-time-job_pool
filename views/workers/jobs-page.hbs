 <!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Job Listings</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
</head>
<body>
  <div class="container-fluid">
    <div class="row p-5">
      <div class="col-md-12 text-center mt-5" style="width: 100%;">
         {{#if succ}}
           <p class="text-success" style="font-size: 30px;"><b>{{succ}}</b></p>
         {{/if}}
         {{#if already}}
         {{!-- {{already}} --}}
           <p class="text-warning" style="font-size: 30px;"><b>Your Already Commited For This Work</b></p>
         {{/if}}
         {{#if state}}
          <p class="text-danger" style="font-size: 28px;"><b>{{state}}</b></p>
            
         {{/if}}
      </div>
      {{#each jobs}}
        {{#if this.ctaccept}}
          <div class="col-md-3 p-5 m-auto">
            <div class="card  text-center text-light" style="width: 18rem;background-color: #15181e;box-shadow: #C993e8 0px 54px 55px, #C993e8 0px -12px 30px, #C993e8 0px 4px 6px, #C993e8 0px 12px 13px, #C993e8 0px -3px 5px;">
              <div class="card-body">
                <h5 class="card-title">Shop Name : {{this.sname}}</h5>
                <h5 class="card-title">Licence Number : {{this.lno}}</h5>
                <h5 class="card-title">Salary (one day) : {{this.salary}}</h5>
                <h5 class="card-title">Work Starting Time {{this.stime}} To {{this.entim}}</h5>
                <h5 class="card-title">Work Starting Date {{this.sdate}} To {{this.edate}}</h5>
                <p class="card-text">{{this.address}}</p>
                <a href="https://www.google.com/maps?q={{this.late}},{{this.long}}" class="btn btn-success">Location</a>
                {{#if isfull}}
                  <p class="mt-4 text-dark bg-warning"><b>Job Requirement Process Done</b></p>
                {{else}}
                  <form action="/worker/applayjob?wkid={{this._id}}&userid={{this.userid}}" method="post" class="m-3 text-light" id="job_form_{{this._id}}">
                    <div>
                      <label for="date">Select Your Own Time</label>
                      <select name="date" id="date_{{this._id}}" onchange="dat(this, '{{this._id}}')">
                        <option>Choose</option>
                        <option value="no">Any Date</option>
                        <option value="yes">Preferred date</option>                   
                      </select>
                    </div> <br>
                    <div id="selectdate_{{this._id}}" style="display: none;">
                      <label for="preferredDates"><b>Choose Preferred Dates</b></label>
                      <input type="text" id="preferredDates_{{this._id}}" class="mb-4" name="preferredDates" placeholder="Select dates" required>
                    </div>
                    <input class="btn btn-outline-warning m-auto" type="submit" value="Ready to join" id="submit_button_{{this._id}}">
                  </form>
                {{/if}}
              </div>
            </div>
          </div>
          <script>
            function dat(selectElement, id) {
              var selectedValue = selectElement.value;
              var selectDateDiv = document.getElementById('selectdate_' + id);
              var submitButton = document.getElementById('submit_button_' + id);
              if (selectedValue === "Choose") {
                submitButton.style.display = "none";
                selectDateDiv.style.display = "none";
              } else if (selectedValue === "yes") {
                submitButton.style.display = "block";
                selectDateDiv.style.display = "block";
                var flatpickrId = '#preferredDates_' + id;
                flatpickr(flatpickrId, {
                  mode: 'multiple',
                  dateFormat: 'Y-m-d',
                  enable: [
                    {
                      from: '{{this.sdate}}',
                      to: '{{this.edate}}'
                    }
                  ]
                });
              } else {
                submitButton.style.display = "block";
                selectDateDiv.style.display = "none";
                var flatpickrInstance = document.querySelector(flatpickrId);
                if (flatpickrInstance) {
                  flatpickrInstance._input.value = "";
                }
              }
            }
          </script>
        {{/if}}
      {{/each}}
     
    </div>
  </div>
 
  <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
</body>
</html>

