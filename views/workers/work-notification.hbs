<div class="container-fluid">
  <div class="row p-5">
    <div class="col-md-12 m-5 p-5">
      {{#if info}}
        <h2 class="text-light m-5" style="font-size: 48px;"><b>{{info.msg}}</b></h2>
      {{else}}
      <h2 class="text-light m-5" style="font-size: 48px;"><b>No Work Notification Found</b></h2>
      {{/if}}
    </div>
  </div>
</div>