<div class="container-fluid">
    <div class="row">
        <div class="col-md-12" style="text-align: center;">
   {{#if ctr}}
            <table class="table text-light">
  <thead>
    <tr>
      <th scope="col">Number</th>
      <th scope="col">Shop Name</th>
      <th scope="col">Licence Number</th>
      <th scope="col">Shop Address</th>
      <th scope="col">Shop District</th>
       <th scope="col">Location</th>
       <th scope="col">Employee Wanted</th>
       <th scope="col">Salary per Head</th>
      <th scope="col">Starting To Ending (Time)</th>
      <th scope="col">Starting To Ending (Date)</th>
      <th scope="col">WorkType</th>
      <th scope="col">User Name</th>
      <th scope="col">User Email</th>
      <th scope="col">User Phone Number</th>
       <th scope="col">Job Add</th>
    </tr>
  </thead>
  <tbody>
   
     {{#each ctr}}
     <tr>          
       <td>{{@index}}</td>
       <td>{{this.sname}}</td>
        <td>{{this.lno}}</td>
        <td>{{this.address}}</td>
        <td>{{this.district}}</td>
        <td><a href="https://www.google.com/maps?q={{this.late}},{{this.long}}" class="btn btn-success">Location</a></td>
        <td>{{this.empno}}</td>
        <td>{{this.salary}}</td>
        <td>{{this.stime}} To {{this.entim}}</td>
        <td>{{this.sdate}} To {{this.edate}}</td>
         <td>{{this.wktype}}</td>
         <td>{{this.user.name}}</td>
         <td>{{this.user.email}}</td>
         <td>{{this.user.ph}}</td>
         <td><a href="/subadmin/recruitment?jobid={{this._id}}&userid={{this.userid}}" class="btn btn-outline-success">Proceed</a></td>
     </tr>
     {{/each}}
    {{else}}
        <h1 class="text-light mt-5 pt-5" style="font-size: 90px;font-weight: 800;">Nothing Found...</h1>
    {{/if}}
  </tbody>
</table>
        </div>
    </div>
</div>


 <style>
    /* Style for the table */
    .table {
        background-color: #343a40; /* Dark background color */
        color: #fff; /* Text color */
        border-radius: 10px; /* Rounded corners */
    }

    /* Style for table headings */
    .table th {
        background-color: #212529; /* Darker background color for headings */
        border: none; /* Remove border */
    }

    /* Style for table body */
    .table tbody tr:nth-child(even) {
        background-color: #454d55; /* Alternate row color */
    }

    /* Style for table cell content */
    .table td, .table th {
        padding: 10px; /* Padding for cell content */
    }

    /* Style for location button */
    .btn-location {
        background-color: #28a745; /* Green background color */
        border-color: #28a745; /* Green border color */
    }

    /* Style for location button on hover */
    .btn-location:hover {
        background-color: #218838; /* Darker green background color on hover */
        border-color: #1e7e34; /* Darker green border color on hover */
    }
</style>
