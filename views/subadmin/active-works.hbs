

<script>
  function req()
  {
    console.log("called")
    document.getElementById('reqs').innerHTML ="Already Requested  Wait For  User Resonse..."
  }
</script>


<div class="container-fluid">
  <div class="row pt-5">
    <div class="col-md-12 mt-5 text-center" style="width: 100%;">
      <i><p id="reqs" class="text-danger" style="font-size: 30px;"></p></i>
    </div>
  </div>
  <div class="row">
    {{#each wrk}}
      <div class="col-md-3 m-auto">
        
        <div class="card mt-5 text-light text-center" style="width: 18rem;background-color: #15181e;box-shadow: rgba(233, 233, 233, 0.25) 0px 50px 100px -20px, rgba(46, 46, 46, 0.3) 0px 30px 60px -30px, rgba(0, 0, 0, 0.35) 0px -2px 6px 0px inset;">
          <div class="card-body">
            <h5 class="card-title">Shop Name : {{this.sname}}</h5>
            <h5 class="card-title">Owner Name : {{this.wkinfo.name}}</h5>
            <p class="card-text">{{this.address}}</p>
            <a
              href="/subadmin/activewrkers?wkid={{this._id}}&userid={{this.wkinfo._id}}"
              class="btn btn-primary"
            >Work More Info</a>
            {{#if this.isreqpay}}
              <br />
              <br />
              <br />
              <button class="btn btn-success" onclick="req()">Request To Pay</button>
              <br /><br />            {{else}}
              <a
                href="/subadmin/reqpay?wkid={{this._id}}&userid={{this.wkinfo._id}}"
                class="btn btn-success mt-5"
              >Request To Pay</a>
            {{/if}}
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</div>

